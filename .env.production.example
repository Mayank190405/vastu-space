APP_URL=http://localhost
ENVIRONMENT=production
NGINX_CONF_PATH=./infrastructure/nginx/gateway.conf

POSTGRES_USER=vastu_user
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
POSTGRES_DB=vastu_db

REDIS_PASSWORD=replace_with_openssl_rand_hex_32

MINIO_ROOT_USER=vastu_minio_admin
MINIO_ROOT_PASSWORD=replace_with_openssl_rand_hex_32

JWT_SECRET=replace_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@krads.co.in
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_NAME=VĀSTU Spatial Platform
SMTP_FROM_EMAIL=noreply@krads.co.in

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
