# Multi-stage production build for VĀSTU Reconstruction Worker Daemon
# Stage 1: Build the Go worker daemon
FROM golang:1.22-alpine AS go-builder

WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/vastu-worker ./cmd/worker/main.go

# Stage 2: Dual runtime with Python 3.10 and C++ native dependencies
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system runtime dependencies for OpenCV, Open3D, and PyTorch (C++ native libraries)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python reconstruction pipeline dependencies with CPU-optimized PyTorch wheels
COPY backend/workers/requirements.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

# Keep metric model dependencies separate so the large reconstruction layer stays cached.
COPY backend/workers/requirements-depth.txt ./requirements-depth.txt
RUN pip install --no-cache-dir -r requirements-depth.txt

# Copy Go worker executable from builder stage
COPY --from=go-builder /app/vastu-worker /app/vastu-worker

# Copy worker modules, scripts, and assets
COPY backend/workers /app/backend/workers
COPY scripts /app/scripts
COPY core /app/core
COPY ml /app/ml
COPY navigation /app/navigation
COPY storage /app/storage
COPY geometry /app/geometry
COPY shared /app/shared

# Pre-create scratch and upload directories
RUN mkdir -p /app/uploads/scratch

ENV WORKERS_PATH=/app/backend/workers
ENV PYTHONPATH=/app:/app/backend/workers:/app/scripts
ENV UPLOAD_DIR=/app/uploads
ENV VASTU_METRIC_DEPTH_MODEL_PATH=/opt/vastu-models/metric-indoor

# Download the pinned metric weights and run real inference before accepting the image.
RUN HF_HOME=/tmp/vastu-model-download python3 scripts/prepare_metric_depth.py --output "$VASTU_METRIC_DEPTH_MODEL_PATH" \
    && rm -rf /tmp/vastu-model-download

# Fail the image build if the complete production reconstruction entrypoint cannot import.
RUN python3 -c "from scripts.capture_reconstruct import main; print('Capture reconstruction imports verified')"

ENTRYPOINT ["/app/vastu-worker"]
