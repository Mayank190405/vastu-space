# ==============================================================================
# VĀSTU SPATIAL PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# THIS IS AN EXAMPLE FILE. DO NOT COMMIT ACTUAL SECRETS HERE.
# The actual production secrets are managed via AWS Secrets Manager (or equivalent).
# 
# Format:
# VARIABLE_NAME=default_value # [TYPE] [REQUIRED/OPTIONAL] - Description
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PORT=8080                               # [INT] [OPTIONAL] - The port the Go backend listens on. Default: 8080.
ENVIRONMENT=production                  # [STRING] [REQUIRED] - 'development', 'staging', or 'production'.
UPLOAD_DIR=/app/uploads                 # [STRING] [REQUIRED] - Absolute path to local temporary upload chunks.

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=[mode]
DATABASE_URL=postgresql://vastu_user:__SECRET__@vastu-postgres:5432/vastu_db?sslmode=disable # [STRING] [REQUIRED] - PostGIS connection string.

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=__SECRET__                   # [STRING] [REQUIRED] - HMAC-SHA256 key (minimum 32 bytes/256 bits).
TOKEN_EXPIRATION_HOURS=24               # [INT] [OPTIONAL] - JWT expiration. Default: 24.
OTP_EXPIRATION_MINUTES=5                # [INT] [OPTIONAL] - OTP validity period. Default: 5.
PASSWORD_HASH_COST=12                   # [INT] [OPTIONAL] - Argon2id cost parameter. Default: 12.

# ------------------------------------------------------------------------------
# 4. EXTERNAL SERVICES - SMTP (EMAIL)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com            # [STRING] [REQUIRED] - SMTP provider hostname.
SMTP_PORT=465                           # [INT] [REQUIRED] - SMTP port (465 for TLS, 587 for STARTTLS).
SMTP_USER=noreply@krads.co.in           # [STRING] [REQUIRED] - SMTP username.
SMTP_PASSWORD=__SECRET__                # [STRING] [REQUIRED] - SMTP password.
SMTP_FROM_NAME=VĀSTU Spatial Platform   # [STRING] [REQUIRED] - Display name for sent emails.
SMTP_FROM_EMAIL=noreply@krads.co.in     # [STRING] [REQUIRED] - Sender email address.

# ------------------------------------------------------------------------------
# 5. EXTERNAL SERVICES - GOOGLE AUTH
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=__SECRET__             # [STRING] [OPTIONAL] - OAuth2 Client ID for Web/Android/iOS.
GOOGLE_CLIENT_SECRET=__SECRET__         # [STRING] [OPTIONAL] - OAuth2 Client Secret.

# ------------------------------------------------------------------------------
# 6. EXTERNAL SERVICES - OBJECT STORAGE (S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com  # [STRING] [REQUIRED] - S3 compatible endpoint URL.
S3_REGION=us-east-1                     # [STRING] [REQUIRED] - S3 Region.
S3_BUCKET_UPLOADS=vastu-quarantine      # [STRING] [REQUIRED] - Bucket for chunked/unverified uploads.
S3_BUCKET_ARTIFACTS=vastu-artifacts     # [STRING] [REQUIRED] - Bucket for verified/processed spatial artifacts.
AWS_ACCESS_KEY_ID=__SECRET__            # [STRING] [REQUIRED] - IAM Access Key for S3 operations.
AWS_SECRET_ACCESS_KEY=__SECRET__        # [STRING] [REQUIRED] - IAM Secret Key.

# ------------------------------------------------------------------------------
# 7. WORKER & PROCESSING SETTINGS
# ------------------------------------------------------------------------------
REDIS_URL=redis://vastu_redis:6379      # [STRING] [REQUIRED] - URL for Redis EventBus.
MAX_CONCURRENT_JOBS=4                   # [INT] [OPTIONAL] - Maximum reconstruction pipelines to run in parallel.
CUDA_VISIBLE_DEVICES=0                  # [STRING] [OPTIONAL] - Limits PyTorch/Open3D to specific GPUs.
