# ==============================================================================
# VĀSTU SPATIAL PLATFORM - AWS EC2 PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Generate secure passwords using: openssl rand -hex 32
# Copy this file to .env.production on your AWS EC2 instance:
#   cp infrastructure/environments/production.env.template .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Set to your EC2 Public IP (e.g. http://54.210.12.34) or your custom domain (e.g. https://vastu.yourdomain.com)
APP_URL=http://localhost
ENVIRONMENT=production

# Nginx Gateway Config:
# Use ./infrastructure/nginx/gateway.conf for HTTP (or during initial SSL setup)
# Use ./infrastructure/nginx/gateway-ssl.conf after SSL certificate is obtained
NGINX_CONF_PATH=./infrastructure/nginx/gateway.conf

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=vastu_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD_32_CHARS
POSTGRES_DB=vastu_db

# ------------------------------------------------------------------------------
# 3. REDIS 7 IN-MEMORY DATA STORE
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_REDIS_PASSWORD_32_CHARS

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Self-Hosted MinIO S3 Container)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=vastu_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_MINIO_PASSWORD_32_CHARS

# ------------------------------------------------------------------------------
# 5. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_CRYPTOGRAPHIC_JWT_KEY
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@krads.co.in
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_NAME=VĀSTU Spatial Platform
SMTP_FROM_EMAIL=noreply@krads.co.in

# ------------------------------------------------------------------------------
# 7. THIRD-PARTY AUTH (OPTIONAL)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
